{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "lib": [
            "esnext"
        ],
        "target": "ESNext",
        "moduleResolution": "NodeNext",
        "module": "NodeNext",
        "strict": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "declaration": true,
        "skipLibCheck": true,
        "useDefineForClassFields": false
    },
    "include": [
        "src/**/*.ts",
        "src/models/**/*.ts",
        "scripts/**/*.ts"
    ]
}